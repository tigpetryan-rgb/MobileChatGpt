DATABASE_URL=sqlite:///./mobile_chatgpt.db
OPENAI_API_KEY=
OPENAI_MANAGER_MODEL=gpt-5.6-terra
OPENAI_WORKER_MODEL=gpt-5.6-terra
OPENAI_TRACE_INCLUDE_SENSITIVE_DATA=false

# Leave all MCP auth values blank for local read-only development. In a remote
# deployment configure all five values together; partial configuration fails closed.
MCP_AUTH_ISSUER_URL=
MCP_RESOURCE_SERVER_URL=
MCP_TOKEN_INTROSPECTION_URL=
MCP_INTROSPECTION_CLIENT_ID=
MCP_INTROSPECTION_CLIENT_SECRET=
